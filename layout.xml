<layout>
    <tokenizer>
        <!-- <token name="NAME">[a-zA-Z_][a-zA-Z0-9_]*</token> -->

        <!--
            Thec idea to make keywords to overcome NAME because its more precise match
            e.g. NAME could have possible characters after the end of the keyword.
        -->
        <token name="STRUCT">struct</token> 
        <token name="OPEN_CURLY">{</token>
        <token name="CLOSE_CURLY">}</token>
        <token name="OPEN_PARENTHESIS">\(</token>
        <token name="CLOSE_PARENTHESIS">\)</token>
        <token name="SEMICOLON">;</token>
        <token name="SPACE">[ \n]+</token>
        <token name="INCREMENT">\+\+</token>
    </tokenizer>

