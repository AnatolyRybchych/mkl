<layout>
    <settings>
        <output_header_dir>./include</output_header_dir>
        <output_source_dir>./src</output_source_dir>
    </settings>

    <tokenizer token_prefix="TOK_">
        <token name="NAME" order="1">[a-zA-Z_][a-zA-Z0-9_]*</token>
        <token name="STRUCT" order="0">struct</token> 
        <token name="OPEN_CURLY">{</token>
        <token name="CLOSE_CURLY">}</token>
        <token name="OPEN_PARENTHESIS">\(</token>
        <token name="CLOSE_PARENTHESIS">\)</token>
        <token name="SEMICOLON">;</token>
        <token name="COMMA">,</token>
        <token name="SPACE">[ \n]+</token>
    </tokenizer>

    <ast>
        <node name="TYPE">
            <token name="NAME" field="name"/>
        </node>

        <node name="FIELDS">
            <node name="TYPE" field="type"/>
            <token name="NAME" field="name"/>
            <token name="SEMICOLON"/>
            <optional>
                <node name="FIELDS" field="next"/>
            </optional>
        </node>

        <node name="ARGS">
            <node name="TYPE" field="type"/>
            <token name="NAME" field="name"/>
            <optional>
                <token name="COMMA"/>
                <node name="ARGS" field="next"/>
            </optional>
        </node>

        <node name="STRUCT">
            <token name="STRUCT"/>
            <token name="NAME" field="name"/>
            <token name="OPEN_CURLY"/>
            <node name="FIELDS" field="fields"/>
            <token name="CLOSE_CURLY"/>
            <token name="SEMICOLON"/>
        </node>

        <node name="FUNC_PROTO">
            <node name="TYPE" field="return_type"/>
            <token name="NAME" field="name"/>
            <token name="OPEN_PARENTHESIS"/>
            <optional>
                <node name="ARGS" field="args"/>
            </optional>
            <token name="CLOSE_PARENTHESIS"/>
        </node>
        
        <node name="FUNC_DECL">
            <node name="FUNC_PROTO"/>
            <token name="SEMICOLON"/>
        </node>

        <node name="TOPLEVEL">
            <any_of field="element">
                <node name="STRUCT"/>
                <node name="FUNC_DECL"/>
            </any_of>
            <optional>
                <node name="TOPLEVEL" field="next"/>
            </optional>
        </node>
    </ast>
</layout>